# Application
APP_NAME=Schnell Electrical Asset Report Management
APP_ENV=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/schnell_reports

# Security / JWT (MUST override in production with a cryptographically random 64+ char secret)
JWT_SECRET_KEY=replace-with-strong-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REMEMBER_ME_EXPIRE_MINUTES=10080

# Persistent File Storage
STORAGE_ROOT=./storage
TEMP_PROCESSING_DIR=./storage/_tmp
MAX_UPLOAD_SIZE_MB=25

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Initial Seed Accounts (used by seed script / startup bootstrap in dev)
SEED_DEFAULT_DATA=true
SEED_ADMIN_NAME=Schnell Administrator
SEED_ADMIN_EMAIL=admin@schnell.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_CUSTOMER_USER_NAME=BBMP Viewer
SEED_CUSTOMER_USER_EMAIL=viewer@bbmp.local
SEED_CUSTOMER_USER_USERNAME=bbmp_viewer
SEED_CUSTOMER_USER_PASSWORD=ChangeMeViewer123!

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api

